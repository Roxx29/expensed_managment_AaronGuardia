<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. Only the backup files (files/backups/) go to the
     user's Google account backup; the database, PIN and settings never do.
     After a reinstall the welcome screen finds them and offers to restore. -->
<full-backup-content>
    <include domain="file" path="backups/" />
</full-backup-content>
