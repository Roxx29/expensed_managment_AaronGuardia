<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same as backup_rules.xml: only files/backups/. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
