rules_version = '2';

// Monchi — paste in Firebase console › Firestore Database › Rules › Publish.
// Admins: create a document in collection `admins` whose ID is your Google
// e-mail (e.g. admins/you@gmail.com, no fields needed). Only you can do that,
// from the console.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function verifiedEmail() { return signedIn() && request.auth.token.email_verified == true; }
    function isBlocked(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.get('blocked', false) == true;
    }

    match /admins/{email} {
      allow read: if isAdmin();
    }

    // Announcement shown on Home: everyone reads, admins write.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // One row per signed-in user, written by the app; `blocked` is admin-only.
    match /users/{uid} {
      // Usage fields for the panel's metrics (usage_ping.dart): plan name,
      // app opens (+1 at a time), the last 60 active days (yyyymmdd) and feature
      // use counts (fixed names, incl. crash/error).
      function validUsage() {
        let d = request.resource.data;
        return d.get('plan', null) in [null, 'monthly', 'yearly', 'lifetime', 'unknown']
          && d.get('opens', 0) is int
          && (d.get('activeDays', []) is list && d.get('activeDays', []).size() <= 60)
          && (d.get('features', {}) is map && d.get('features', {}).size() <= 40);
      }
      allow read: if isMe(uid) || isAdmin();
      // Deleting the row would clear `blocked`, so blocked users can't.
      allow delete: if isAdmin() || (isMe(uid) && !resource.data.get('blocked', false));
      allow create: if isMe(uid) && verifiedEmail()
        && request.resource.data.keys().hasOnly(['email', 'name', 'lastSeen', 'appBuild', 'playPremium', 'plan', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && validUsage();
      allow update: if isAdmin() || (isMe(uid) && verifiedEmail()
        && changed().hasOnly(['email', 'name', 'lastSeen', 'appBuild', 'playPremium', 'plan', 'opens', 'activeDays', 'features'])
        && request.resource.data.email == request.auth.token.email
        && validUsage()
        && (!('opens' in changed()) || request.resource.data.opens <= resource.data.get('opens', 0) + 1));
    }

    // Premium gifted by e-mail (document ID = lower-case e-mail).
    match /grants/{email} {
      allow read: if (verifiedEmail() && request.auth.token.email.lower() == email) || isAdmin();
      allow write: if isAdmin();
    }

    // Encrypted cloud backup (cloud_backup.dart): metadata + text chunks.
    // Only the owner reads it; it is encrypted on the phone anyway.
    match /backups/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow delete: if isMe(uid) || isAdmin();
      allow create, update: if isMe(uid) && !isBlocked(uid)
        && request.resource.data.keys().hasOnly(['version', 'chunks', 'size', 'updatedAt'])
        && request.resource.data.chunks is int && request.resource.data.chunks <= 120
        && request.resource.data.updatedAt == request.time;
      match /chunks/{chunk} {
        allow read: if isMe(uid);
        allow list: if isAdmin(); // to delete them
        allow delete: if isMe(uid) || isAdmin();
        // `<version millis>_<index>`, index < 120 (same cap as the metadata),
        // so one account can't fill the project's storage with extra chunks.
        allow create, update: if isMe(uid) && !isBlocked(uid)
          && chunk.matches('^[0-9]{13}_[0-9]{1,3}$')
          && int(chunk.split('_')[1]) < 120
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 900000;
      }
    }

    // Shared wallets (claude/WALLETS.md). Everything members read is
    // encrypted on the phones with the wallet key, which never comes here.
    match /wallets/{wid} {
      function isMember() {
        return signedIn() && exists(/databases/$(database)/documents/wallets/$(wid)/members/$(request.auth.uid));
      }
      function validChunk(chunk) {
        return chunk.matches('^[0-9]{13}_[0-9]{1,3}$')
          && int(chunk.split('_')[1]) < 120
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 900000;
      }
      function validProfile() {
        return request.resource.data.profile is string
          && request.resource.data.profile.size() <= 100000
          && request.resource.data.updatedAt == request.time;
      }
      // Admins read only this metadata (count for the panel); chunks stay members-only.
      allow read: if isMember() || isAdmin();
      allow create: if signedIn() && !isBlocked(request.auth.uid)
        && request.resource.data.keys().hasOnly(['owner', 'version', 'chunks', 'size', 'updatedAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.version == '' && request.resource.data.chunks == 0
        && request.resource.data.updatedAt == request.time;
      // Snapshots stay small (the app caps them at 5 MB = 6 chunks).
      allow update: if isMember() && !isBlocked(request.auth.uid)
        && changed().hasOnly(['version', 'chunks', 'size', 'updatedAt'])
        && request.resource.data.version is string && request.resource.data.version.matches('^[0-9]{13}$')
        && request.resource.data.chunks is int && request.resource.data.chunks >= 0 && request.resource.data.chunks <= 8
        && request.resource.data.size is int && request.resource.data.size <= 7200000
        && request.resource.data.updatedAt == request.time;

      match /chunks/{chunk} {
        allow read, delete: if isMember();
        allow create, update: if isMember() && !isBlocked(request.auth.uid) && validChunk(chunk);
      }

      // One per member: `profile` = encrypted name + photo. The owner joins
      // right after creating the wallet; everyone else needs an invitation of
      // this wallet that is less than 7 days old. The owner can remove anyone.
      match /members/{uid} {
        function invite() {
          return get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data;
        }
        allow read: if isMember();
        allow delete: if isMe(uid) || get(/databases/$(database)/documents/wallets/$(wid)).data.owner == request.auth.uid;
        allow create: if isMe(uid) && !isBlocked(uid)
          && !exists(/databases/$(database)/documents/wallets/$(wid)/removed/$(uid))
          && request.resource.data.keys().hasOnly(['invite', 'profile', 'updatedAt'])
          && validProfile()
          && (get(/databases/$(database)/documents/wallets/$(wid)).data.owner == uid
            || (request.resource.data.invite is string
              && request.resource.data.invite.matches('^[A-Za-z0-9_-]{22}$')
              && invite().walletId == wid
              && request.time < invite().createdAt + duration.value(7, 'd')));
        allow update: if isMe(uid) && !isBlocked(uid) && changed().hasOnly(['profile', 'updatedAt']) && validProfile();
      }

      // Members the owner removed: they can't rejoin with an old invite.
      match /removed/{uid} {
        allow read: if isMember();
        allow create, delete: if get(/databases/$(database)/documents/wallets/$(wid)).data.owner == request.auth.uid;
      }
    }

    // Wallet invitations: the app shares `<inviteId>.<wallet key>`; only the
    // id is stored. Opened by id, never listed.
    match /invites/{id} {
      allow get: if signedIn();
      allow create: if signedIn() && !isBlocked(request.auth.uid)
        && request.resource.data.keys().hasOnly(['walletId', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/wallets/$(request.resource.data.walletId)/members/$(request.auth.uid));
      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid
        || get(/databases/$(database)/documents/wallets/$(resource.data.walletId)).data.owner == request.auth.uid);
    }

    // Promo codes. Users can open one code by name but never list them.
    match /codes/{code} {
      allow get: if signedIn();
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn()
        && changed().hasOnly(['uses'])
        && request.resource.data.uses == resource.data.uses + 1
        && request.resource.data.uses <= resource.data.maxUses
        && resource.data.active == true
        && (resource.data.expiresAt == null || request.time < resource.data.expiresAt)
        && getAfter(/databases/$(database)/documents/redemptions/$(request.auth.uid)).data.code == code
        && getAfter(/databases/$(database)/documents/redemptions/$(request.auth.uid)).data.redeemedAt == request.time);
    }

    // The code a user redeemed, one per user (an admin deletes it to allow
    // another). Written together with the code's `uses + 1`.
    match /redemptions/{uid} {
      function validRedemption() {
        let r = request.resource.data;
        let before = get(/databases/$(database)/documents/codes/$(r.code)).data;
        let after = getAfter(/databases/$(database)/documents/codes/$(r.code)).data;
        return r.keys().hasOnly(['code', 'days', 'redeemedAt'])
          && r.redeemedAt == request.time
          && r.days == before.days
          && after.uses == before.uses + 1;
      }
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid) && !isBlocked(uid) && validRedemption();
      allow update, delete: if isAdmin(); // revoke / allow a new code
    }

    // Problem reports (tickets) sent from the app: More › Report a problem.
    // Anyone with a verified e-mail creates their own; only admins change them.
    match /reports/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if verifiedEmail() && !isBlocked(request.auth.uid)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'category', 'reason', 'appBuild', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.category in ['error', 'backup', 'sync', 'payments', 'other']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10 && request.resource.data.reason.size() <= 1000
        && request.resource.data.appBuild is string && request.resource.data.appBuild.size() <= 20
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }
  }
}
