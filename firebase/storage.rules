rules_version = '2';

// Monchi — paste in Firebase console › Storage › Rules › Publish.
// The first time, the console asks to let Storage read Firestore: accept.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email));
    }
    function blocked(uid) {
      return firestore.exists(/databases/(default)/documents/users/$(uid))
        && firestore.get(/databases/(default)/documents/users/$(uid)).data.get('blocked', false) == true;
    }

    // One encrypted backup per account (lib/features/backup/application/cloud_backup.dart).
    match /users/{uid}/backup.enc.json {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid && !blocked(uid)
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType == 'application/json';
    }
  }
}
